    {
      "id": "UZzy_i9zAWHb_6I6FvFi5",
      "type": "text",
      "x": 723.7148951071392,
      "y": 161.74198090146552,
      "width": 176.67856395769675,
      "height": 14.671588241378032,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "a7h",
