      "boundElements": [],
      "updated": 1785199545118,
      "link": null,
      "locked": false,
      "text": "\\\\SRV-JD-FIGUEIRA\\ReplData",
      "fontSize": 11.737270593102426,
      "fontFamily": 8,
      "textAlign": "center",
      "verticalAlign": "top",
